 quest.CBE33F71A808807A.quest_subtitle: "Fiamme del Nether"
 quest.CBE33F71A808807A.quest_desc: ["Il fuoco del Nether alimenta le prove successive. Raccogli otto verghe di Blaze e affronta i loro guardiani."]
 quest.5CC7EBD22D9BA716.title: "Frammenti dell’eco"
 quest.5CC7EBD22D9BA716.quest_subtitle: "Frammenti dell’eco"
 quest.5CC7EBD22D9BA716.quest_desc: ["Recupera quattro frammenti dell’eco dalle rovine più profonde. Ti serviranno per la reliquia finale."]
 quest.D125B6AB6394B9D7.title: "Il cuore della forgia"
 quest.D125B6AB6394B9D7.quest_subtitle: "Il cuore della forgia"
 quest.D125B6AB6394B9D7.quest_desc: ["Rafforza il tuo equipaggiamento con la netherite. Non affrontare l’ultima prova senza una protezione adeguata."]
