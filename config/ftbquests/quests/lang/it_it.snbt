 quest.D37C4BFFDD4FE5F8.quest_subtitle: "Una stella caduta"
 quest.D37C4BFFDD4FE5F8.quest_desc: ["Il Wither custodisce una stella del Nether. Preparati con cura e sconfiggilo."]
