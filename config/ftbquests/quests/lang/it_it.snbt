 quest.35B7EC7FE35E0C0D.title: "Il potere assoluto"
 quest.35B7EC7FE35E0C0D.quest_subtitle: "Il potere assoluto"
 quest.35B7EC7FE35E0C0D.quest_desc: ["Hai raggiunto il termine del viaggio. Richiedi il potere assoluto: la God Wand è la ricompensa finale. Usala con responsabilità."]
